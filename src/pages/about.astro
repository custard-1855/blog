---
import Base from '../layouts/Base.astro';

// TODO: すべて実際の内容に書き換える
const NAME = '竹本 志恩';
const BIO = '';
const CAREER = [
  { period: '2025 —', org: '東洋大学大学院 情報連携学科 情報連携学専攻', desc: '川原研にて自律ネットワークに関する研究を検討中。' },
  { period: '2022 — 2025', org: '東洋大学 情報連携学科 情報連携学部', desc: '川原研に配属。音による行動認識を検討。' },
];
// const SKILLS = ['', 'スキル2', 'スキル3'];
---
<Base title="About" description={BIO}>
  <div class="page">
    <main>
      <header class="masthead">
        <h1>{NAME}</h1>
        <p class="standfirst">{BIO}</p>
      </header>

      <section class="about-section">
        <p class="eyebrow">Career</p>
        <ul class="about-career">
          {CAREER.map((c) => (
            <li>
              <span class="about-career-period">{c.period}</span>
              <div>
                <p class="about-career-org">{c.org}</p>
                <p class="desc">{c.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="about-section">
        <p class="eyebrow">Skills</p>
        <ul class="about-skills">
          {SKILLS.map((s) => <li>{s}</li>)}
        </ul>
      </section>
    </main>
  </div>
</Base>
